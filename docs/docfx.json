{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "filter": "filterConfig.yml",
      "dest": "api"
    }
  ],
  "build": {
    "globalMetadata": {
      "_appName": "pootisbot",
      "_appTitle": "pootisbot"
    },
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      },
      {
        "src": "../",
        "files": [
            "CHANGELOG.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "assets/**/*"
        ]
      }
    ],
    "xref": [
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json",
      "https://docs.discordnet.dev/xrefmap.yml"
    ],
    "output": "_site"
  }
}